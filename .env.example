# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Market Data API Providers (Optional / Licensed)
# If empty, real-time public feeds & adapters are used, or marked as "DADOS EM TEMPO REAL NÃO CONFIGURADOS"
B3_API_KEY=""
US_MARKET_API_KEY=""
CRYPTO_API_KEY=""
NEWS_API_KEY=""

# Optional Local AI / Ollama URL
OLLAMA_URL="http://localhost:11434"
AI_PROVIDER="gemini" # or ollama

# Database & Cache (Optional production connections)
DATABASE_URL=""
REDIS_URL=""
JWT_SECRET="marketai-secret-key-prod-2026"

